[
  {
    "name": "HTTP1 escaped target and duplicate UTF8 fields",
    "entry": {
      "type": "http",
      "method": "GET",
      "url": "https://example.test/a%2Fb?x=1&x=#ignored",
      "host": "example.test",
      "status": "299 Custom Reason",
      "statusCode": 299,
      "request": {
        "proto": "HTTP/1.1",
        "headerFields": [
          {
            "name": "Host",
            "value": "example.test"
          },
          {
            "name": "x-Dup",
            "value": "一"
          },
          {
            "name": "X-Dup",
            "value": ""
          },
          {
            "name": "x-Dup",
            "value": "😀"
          }
        ]
      },
      "response": {
        "proto": "HTTP/1.0",
        "headerFields": [
          {
            "name": "Content-Length",
            "value": "0"
          }
        ]
      }
    },
    "requestHead": "GET /a%2Fb?x=1&x= HTTP/1.1\r\nHost: example.test\r\nx-Dup: 一\r\nX-Dup: \r\nx-Dup: 😀\r\n\r\n",
    "responseHead": "HTTP/1.0 299 Custom Reason\r\nContent-Length: 0\r\n\r\n"
  },
