  {
    "name": "HTTP2 pseudo headers override metadata and retain duplicates",
    "entry": {
      "type": "http",
      "method": "GET",
      "url": "https://example.test/",
      "host": "example.test",
      "status": "200 OK",
      "statusCode": 200,
      "request": {
        "proto": " http/2 ",
        "headerFields": [
          {
            "name": ":method",
            "value": "POST"
          },
          {
            "name": "accept",
            "value": "*/*"
          },
          {
            "name": ":authority",
            "value": "upstream.test"
          },
          {
            "name": ":path",
            "value": "/中文?q=%2F"
          },
          {
            "name": ":scheme",
            "value": "https"
          },
          {
            "name": ":authority",
            "value": "other.test"
          },
          {
            "name": "X-Dup",
            "value": "一"
          },
          {
            "name": "x-dup",
            "value": ""
          },
          {
            "name": ":protocol",
            "value": "websocket"
          }
        ]
      },
      "response": {
        "proto": "HTTP/2.0",
        "headerFields": [
          {
            "name": ":status",
            "value": "201"
          },
          {
            "name": "set-cookie",
            "value": "a=1"
          },
          {
            "name": "Set-Cookie",
            "value": "b="
          },
          {
            "name": ":scheme",
            "value": "https"
          }
        ]
      }
    },
    "requestHead": "POST /中文?q=%2F HTTP/2.0\r\nhost: upstream.test\r\nhost: other.test\r\naccept: */*\r\nX-Dup: 一\r\nx-dup: \r\nprotocol: websocket\r\n\r\n",
    "responseHead": "HTTP/2.0 201\r\nset-cookie: a=1\r\nSet-Cookie: b=\r\n\r\n"
  },
  {
    "name": "HTTP2 metadata fallback without reason phrase",
    "entry": {
      "type": "http",
      "method": "GET",
      "url": "https://example.test?x=1",
      "host": "example.test",
      "status": "200 OK",
      "statusCode": 0,
      "request": {
        "proto": "HTTP/2.0",
        "headerFields": [
          {
            "name": "accept",
            "value": "*/*"
          }
        ],
        "headerOrderUnavailable": true
      },
      "response": {
        "proto": "HTTP/2",
        "headerFields": [
          {
            "name": "server",
            "value": "test"
          }
        ],
        "headerOrderUnavailable": true
      }
    },
    "requestHead": "GET /?x=1 HTTP/2.0\r\naccept: */*\r\n\r\n",
    "responseHead": "HTTP/2.0 200\r\nserver: test\r\n\r\n"
  },
